# Copy to /etc/taikyoku/tourney.env and adjust.

BIN=/opt/taikyoku_shogi/target/release/taikyoku_shogi
SEED_MODEL=/opt/taikyoku_shogi/models/ab-seed.json
GRID_OUT=/opt/taikyoku_shogi/models/loud-grid
MANIFEST=/opt/taikyoku_shogi/models/loud-grid/manifest.json
OUTDIR=/opt/taikyoku_shogi/data/raw/tourney
JOBS=4
DEPTH=8
# Soft AB budget (ms). Empty = fixed depth only.
TIME_MS=1000

# Fresh run: leave RUN_ID empty (script invents loud-swiss-…).
# Resume: set both:
# RUN_ID=loud-swiss-20260101T000000Z
# RESUME=1
# SKIP_GEN=1
