# Copy to /etc/taikyoku/worker.env and adjust.
# Loaded by systemd EnvironmentFile= for `worker daemon`.

JOBS=4
BATCH=8
DEPTH=2
BLACK=ab
WHITE=ab
# MODEL=models/ab-seed.json
# QDEPTH=2
STARTS=random
# STARTS=fischer
# STARTS=data/raw/starts
# STARTS=opening
OUTDIR=data/raw/games
# 0 = per-game OS entropy (recommended). N>0 = deterministic sequence N, N+1, …
SEED_BASE=0
# SLEEP_SECS=0
# STATUS=data/run/status.json
# MAX_MOVES=20000
