[Unit]
Description=Supervised Taikyoku tournament coordinator
After=network.target
RequiresMountsFor=/mnt/HC_Volume_107032879

[Service]
Type=simple
WorkingDirectory=/opt/taikyoku_shogi
EnvironmentFile=/etc/taikyoku/coordinator.env
ExecStartPre=/usr/bin/python3 /opt/taikyoku_shogi/deploy/storage_guard.py /etc/taikyoku/storage.json
ExecStart=/usr/bin/python3 /opt/taikyoku_shogi/deploy/tourney_analysis.py _supervise --run-dir ${RUN_DIR}
KillMode=control-group
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
