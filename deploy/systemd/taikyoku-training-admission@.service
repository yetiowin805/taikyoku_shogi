[Unit]
Description=Automatically admit completed training models for %i
After=local-fs.target taikyoku-coordinator.service
RequiresMountsFor=/mnt/HC_Volume_107032879

[Service]
Type=simple
EnvironmentFile=/etc/taikyoku/%i-admission.env
ExecStart=/usr/bin/python3 ${ADMISSION} ${CONFIG} --watch
CPUQuota=100%
AllowedCPUs=1 3-7
MemoryMax=4G
TasksMax=64
KillMode=control-group
Restart=on-failure
RestartSec=300
Nice=10

[Install]
WantedBy=multi-user.target
