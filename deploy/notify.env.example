# Copy to /etc/taikyoku/notify.env and fill in credentials.
# Used by deploy/notify.sh (sourced).

# Email (preferred if msmtp is configured)
NOTIFY_TO=yeticarlken02@gmail.com

# Optional: msmtp account name from ~/.msmtprc (default: default)
# MSMTP_ACCOUNT=default

# Optional push alternative / addition (https://ntfy.sh)
# NTFY_TOPIC=taikyoku-your-secret-topic
# NTFY_SERVER=https://ntfy.sh
