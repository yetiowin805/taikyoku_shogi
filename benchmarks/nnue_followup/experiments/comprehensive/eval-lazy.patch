+}
+#[derive(Debug, Clone)]
+pub struct Accumulator {
+    pub net: Arc<Network>,
+    eager: std::cell::RefCell<EagerAccumulator>,
+    frames: std::cell::RefCell<Vec<DeferredFrame>>,
+}
+impl Accumulator {
+    pub fn new(net: Arc<Network>, board: &Board) -> Self {
+        Self { net: net.clone(), eager: std::cell::RefCell::new(EagerAccumulator::new(net, board)), frames: Default::default() }
+    }
+    pub fn matches(&self, net: &Arc<Network>) -> bool { Arc::ptr_eq(&self.net, net) }
+    fn materialize(&self) {
+        let mut frames=self.frames.borrow_mut();
+        if frames.last().is_none_or(|f|f.saved.is_some()){return;}
+        let mut eager=self.eager.borrow_mut();
+        for frame in frames.iter_mut().filter(|f|f.saved.is_none()) {
+            frame.saved=Some(eager.save_and_apply(&frame.subs, frame.add.as_ref()));
+        }
+    }
+    pub fn residual(&self, stm: Color) -> i32 {
+        self.materialize();
+        self.eager.borrow().residual(stm)
+    }
+    pub fn change(&mut self, p: &Piece, sign: i32) {
+        self.materialize();
+        self.eager.get_mut().change(p,sign);
+    }
+    pub fn matches_rebuild(&self, board: &Board) -> bool {
+        self.materialize();
+        self.eager.borrow().matches_rebuild(board)
+    }
+    pub(crate) fn save_and_apply(&mut self, subs: Vec<Piece>, add: Option<Piece>) -> Snapshot {
+        let frames=self.frames.get_mut();
+        let saved=Snapshot {net:self.net.clone(),depth:frames.len()};
+        frames.push(DeferredFrame{subs,add,saved:None});
+        saved
+    }
+    pub(crate) fn restore_sums(&mut self, saved: Snapshot) -> bool {
+        if !Arc::ptr_eq(&saved.net,&self.net) || self.frames.get_mut().len()!=saved.depth+1 {return false;}
+        let frame=self.frames.get_mut().pop().unwrap();
+        if let Some(snapshot)=frame.saved {self.eager.get_mut().restore_sums(snapshot)} else {true}
+    }
+    #[cfg(test)]
+    pub(crate) fn materialized_sums(&self) -> Vec<i32> { self.materialize();self.eager.borrow().sums.clone() }
+}
