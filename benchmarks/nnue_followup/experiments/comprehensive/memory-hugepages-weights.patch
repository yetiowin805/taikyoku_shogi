+//! Best-effort huge-page advice for large, anonymous NNUE buffers.
+#[cfg(target_os = "linux")]
+pub(super) fn advise<T>(values: &mut [T]) {
+    let bytes = std::mem::size_of_val(values);
+    if bytes < 4 * 1024 * 1024 { return; }
+    let page = unsafe { libc::sysconf(libc::_SC_PAGESIZE) };
+    if page <= 0 { return; }
+    let page = page as usize;
+    let ptr = values.as_mut_ptr() as usize;
+    // Advise only pages wholly owned by this allocation; no neighboring heap
+    // allocation or allocator metadata participates. A failed hint is harmless.
+    let start = ptr.div_ceil(page) * page;
+    let end = (ptr + bytes) / page * page;
+    if end > start {
+        unsafe { libc::madvise(start as *mut libc::c_void, end - start, libc::MADV_HUGEPAGE); }
+    }
+}
+#[cfg(not(target_os = "linux"))]
+pub(super) fn advise<T>(_values: &mut [T]) {}
