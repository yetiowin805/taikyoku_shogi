+    /// Targets that finish in the enemy promotion zone. Skip rays pointing
+    /// away from that zone before generating destinations, preserving blockers.
+    pub(crate) fn generate_promotion_targets<B: BoardLike>(
+        piece: &Piece,
+        board: &B,
+        capabilities: &[MovementCapability],
+    ) -> Vec<Position> {
+        let in_zone = |rank: u8| match piece.color {
+            Color::Black => rank >= 25,
+            Color::White => rank <= 10,
+        };
+        if in_zone(piece.position.rank) {
+            return Self::generate_targets(piece, board, capabilities);
+        }
+        // Directions in capabilities are relative to Black, so forward rays
+        // remain N/NE/NW for both colours before the standard colour transform.
+        let forward = Direction::N.to_bit() | Direction::NE.to_bit() | Direction::NW.to_bit();
+        let mut targets = Vec::new();
+        for capability in capabilities {
+            let generated = match capability {
+                MovementCapability::Simple { directions, max_distance } =>
+                    Self::generate_simple(piece, board, *directions & forward, *max_distance, false),
+                MovementCapability::Range { directions, blocking, cannot_jump_over } =>
+                    Self::generate_range(piece, board, *directions & forward, *blocking, cannot_jump_over, false),
+                _ => Self::generate_for_capability(piece, board, capability, false),
+            };
+            targets.extend(generated.into_iter().filter(|target| in_zone(target.rank)));
