+    fn promotion_zone_direct_rays_match_full_generation() {
+        // Every promotable type, both orientations, immediately outside/inside
+        // the zone plus long rays; friendly and enemy blockers on multiple rays.
+        for color in [Color::Black, Color::White] {
+            for rank in [3, 10, 11, 18, 24, 25, 32] {
+                for &kind in ALL_PIECE_TYPES {
+                    if !promotes_into_big_piece(kind) { continue; }
+                    let mut state = GameState::new();
+                    let piece = Piece::new(kind, color, Position::new(18, rank).unwrap());
+                    let config = MovementConfig::for_piece(&piece);
+                    if config.capabilities.iter().any(|cap| matches!(cap, MovementCapability::TwoStep { .. })) { continue; }
+                    state.place_piece(piece);
+                    for (df, dr, blocker_color) in [(0, 2, color), (2, 2, color.opposite()), (-2, -2, color.opposite())] {
+                        if let Some(pos) = piece.position.offset(df, dr) {
+                            state.place_piece(Piece::new(PieceType::Pawn, blocker_color, pos));
+                        }
+                    }
+                    let mut all = Vec::new();
+                    state.generate_legal_moves_for_pieces_mode(&[piece], LegalMoveGen::All, &mut all);
+                    let expected: Vec<_> = all.into_iter().filter(|mv| mv.promoted).collect();
+                    let mut actual = Vec::new();
+                    state.emit_standard_promotions_for_piece(&piece, &mut actual);
+                    assert_eq!(actual, expected, "{color:?} {rank} {kind:?}");
+                }
+            }
+        }
+    }
