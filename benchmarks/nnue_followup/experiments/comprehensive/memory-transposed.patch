+pub(super) fn transpose32(h1: &[i8], inputs: usize) -> Vec<i8> {
+    assert_eq!(h1.len(), 32 * inputs);
+    assert_eq!(inputs % 4, 0);
+    let mut transposed = vec![0; h1.len()];
+    for group in 0..inputs / 4 {
+        for output in 0..32 {
+            for k in 0..4 {
+                transposed[group * 128 + output * 4 + k] = h1[output * inputs + group * 4 + k];
+            }
+        }
+    }
+    transposed
+}
+
+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "avx2,avxvnni")]
+unsafe fn avx_vnni32_transposed(x: &[u8], transposed: &[i8], out: &mut [i32; 32]) {
+    use std::arch::x86_64::*;
+    let mut sums = [_mm256_setzero_si256(); 4];
+    for (group, xs) in x.chunks_exact(4).enumerate() {
+        let input = _mm256_set1_epi32(i32::from_le_bytes(xs.try_into().unwrap()));
+        for k in 0..4 {
+            let weights = _mm256_loadu_si256(transposed.as_ptr().add(group * 128 + k * 32).cast());
+            sums[k] = _mm256_dpbusd_avx_epi32(sums[k], input, weights);
+        }
+    }
+    for k in 0..4 {
+        _mm256_storeu_si256(out.as_mut_ptr().add(k * 8).cast(), sums[k]);
+    }
+}
+
+pub(super) fn affine32_transposed(x: &[u8], h1: &[i8], transposed: &[i8], out: &mut [i32; 32]) {
+    assert_eq!(h1.len(), x.len() * 32);
+    assert_eq!(x.len() % 64, 0);
+    #[cfg(target_arch = "x86_64")]
+    if transposed.len() == h1.len()
+        && !(is_x86_feature_detected!("avx512vnni") && is_x86_feature_detected!("avx512bw"))
+        && is_x86_feature_detected!("avxvnni") && is_x86_feature_detected!("avx2")
+    {
+        // SAFETY: the complete transposed matrix and input lengths are checked;
+        // runtime detection supplies both required instruction sets.
+        unsafe { avx_vnni32_transposed(x, transposed, out); }
+        return;
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    let _ = transposed;
+    affine32(x, h1, out);
+}
