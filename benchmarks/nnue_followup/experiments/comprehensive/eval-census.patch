+pub(crate) fn study_saturation(net: &Arc<Network>, signed: f32, mate_score: i32) {
+    let (lo,hi)=net.residual_bounds();
+    let material=signed.round() as i32;
+    let guaranteed=material+lo>=mate_score/2 || material+hi<=-mate_score/2;
+    STUDY.with(|v|v.borrow_mut().clamp_shortcuts+=u64::from(guaranteed));
+}
+pub(crate) fn study_position(net: &Arc<Network>, key: u64) {
