+}
+impl Network {
+    fn residual_bounds(&self)->(i32,i32) {
+        // Every final hidden activation lies in [0,1]. Follow the exact f32
+        // accumulation order: IEEE operations are monotone, so this remains
+        // conservative including rounding and the final clamp.
+        let mut lo=self.out_bias; let mut hi=self.out_bias;
+        for &v in &self.out {lo+=v.min(0.);hi+=v.max(0.);}
+        ((lo*1000.).round().clamp(-100_000.,100_000.) as i32,
+         (hi*1000.).round().clamp(-100_000.,100_000.) as i32)
+    }
+}
