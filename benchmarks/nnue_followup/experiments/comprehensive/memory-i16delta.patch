+        net.weights.fill(10_000);
+        let net = Arc::new(net);
+        let pieces: Vec<_> = (0..5).map(|x| Piece::new(crate::piece::PieceType::Pawn,
+            Color::Black, Position::new(x, 12).unwrap())).collect();
+        let mut board = Board::new();
+        for &p in &pieces { board.place_piece(p); }
+        for _ in 0..2 {
+            let mut acc = Accumulator::new(net.clone(), &board);
+            for _ in 0..2 {
+                let saved = acc.save_and_apply(&pieces, None);
+                assert_eq!(acc.sums, reference(&net, &Board::new()));
+                assert!(acc.storage.delta_wide.iter().any(|d| !d.is_empty()));
+                assert!(acc.restore_sums(saved));
+                assert_eq!(acc.sums, reference(&net, &board));
+            }
+        }
+    }
